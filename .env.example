# Copy to .env and fill in what you use. Vendor keys use their standard names.
# Provider is auto-detected from the keys present (openai > anthropic > mistral > gemini > groq > openrouter),
# falling back to a local Ollama. Force one with REFINER_PROVIDER.

# --- cloud providers ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# MISTRAL_API_KEY=...
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# OPENROUTER_API_KEY=...

# --- what to use by default ---
# REFINER_PROVIDER=ollama            # openai | anthropic | mistral | gemini | groq | openrouter | ollama | lmstudio | openai-compatible
# REFINER_MODEL=llama3.1             # provider-specific model name; omit for the provider default
# REFINER_BASE_URL=http://localhost:11434
# REFINER_API_KEY=                   # only for openai-compatible servers that want one
# REFINER_TEMPERATURE=0.4
# REFINER_MAX_TOKENS=4096
# REFINER_TIMEOUT=300
# REFINER_CONCURRENCY=4              # parallel agent calls; default 1 for local providers, 4 for cloud

# --- files ---
# REFINER_BOARDS_DIR=./my-boards     # extra directory of board YAMLs
# REFINER_RUNS_DIR=./runs
# REFINER_DEFAULT_BOARD=startup

# --- server ---
# REFINER_HOST=127.0.0.1
# REFINER_PORT=8000
